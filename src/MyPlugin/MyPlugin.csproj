<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <UseWPF>false</UseWPF>
    <GenerateTargetFrameworkMonikerAttribute>false</GenerateTargetFrameworkMonikerAttribute>
    <StartupObject></StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GrapeCity.Forguncy.Plugin">
      <HintPath>bin/GrapeCity.Forguncy.Plugin.dll</HintPath>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.CellTypes">
      <HintPath>bin/GrapeCity.Forguncy.CellTypes.dll</HintPath>
    </Reference>
    <Reference Include="Forguncy.Commands">
      <HintPath>bin/Forguncy.Commands.dll</HintPath>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.ServerApi">
      <HintPath>bin/GrapeCity.Forguncy.ServerApi.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.ComponentModel" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin/*.dll" />
  </ItemGroup>
</Project>
